# Kalshi API credentials
KALSHI_API_KEY_ID=replace-me
KALSHI_PRIVATE_KEY_PATH=/etc/kalshi-agent/kalshi_private_key.pem

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXX/YYYY

# Bearer token for /api/control/* endpoints. Generate with: openssl rand -hex 32
CONTROL_BEARER_TOKEN=replace-me-with-32-bytes-hex

# Path to YAML config
KALSHI_AGENT_CONFIG=/etc/kalshi-agent/config.yaml
